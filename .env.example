# Copy to .env. Never distribute .env or commit API keys.
# Endpoints accept a base URL, /v1, or a complete API path.
JEV_URL=http://127.0.0.1:8007/v1/systemone
JEV_MODEL=d3-flash
JEV_API_KEY=
# Local presentation substitute; set VLM_MODEL to your deployed model on Windows.
VLM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VLM_MODEL=qwen3.6-flash
VLM_API_KEY=
VLM_ENABLE_THINKING=false
# dashscope: enable_thinking; chat_template: chat_template_kwargs; omit: no vendor field
VLM_THINKING_MODE=dashscope
VLM_JSON_MODE=true
VLM_TRUST_ENV=true
JEV_TRUST_ENV=false
MODEL_TIMEOUT=90
JEV_THRESHOLD=0.80
JEV_MARGIN=0.15
# Demo server binds to localhost by default.
HOST=127.0.0.1
PORT=8095
